include LICENSE README.md CHANGELOG.md src/charset_normalizer/py.typed dev-requirements.txt SECURITY.md noxfile.py _build_hook/*.py
include src/charset_normalizer/*.pyx src/charset_normalizer/*.pxd
exclude src/charset_normalizer/*.c
recursive-include data *.md
recursive-include data *.txt
recursive-include docs *
recursive-include tests *
recursive-exclude .github/ *
recursive-exclude __pycache__/ *
global-exclude *.pyc
